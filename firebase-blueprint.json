{
  "entities": {
    "TimelineEntry": {
      "title": "TimelineEntry",
      "description": "Historical alignment trends tracking algorithmic scoring for specific projects over time.",
      "type": "object",
      "properties": {
        "projectName": { "type": "string", "description": "The custom business track name of the audited workspace." },
        "date": { "type": "string", "description": "The formatted text statement of completion date." },
        "timestamp": { "type": "number", "description": "The unix epoch recording timestamp." },
        "biasScore": { "type": "number", "description": "The calculated numeric bias assessment score." },
        "module": { "type": "string", "description": "The visual suite tab context used." }
      },
      "required": ["projectName", "date", "timestamp", "biasScore", "module"]
    },
    "SharedReport": {
      "title": "SharedReport",
      "description": "Public compliance reports shared and saved in the cloud.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "6-character alphanumeric reference id." },
        "timestamp": { "type": "string", "description": "Date of general logging." },
        "module": { "type": "string", "description": "Type of target audits conducted." },
        "biasScore": { "type": "number", "description": "The quantitative risk ranking." },
        "findings": { "type": "string", "description": "The JSON-stringified findings contents." }
      },
      "required": ["id", "timestamp", "module", "biasScore", "findings"]
    },
    "PublicAudit": {
      "title": "PublicAudit",
      "description": "Anonymized public audit entries measuring regulatory compliance across sectors.",
      "type": "object",
      "properties": {
        "industry": { "type": "string", "description": "Sector category (e.g. Banking, Healthcare, Hiring, Criminal Justice)." },
        "biasScore": { "type": "number", "description": "Numeric score rating (0-100)." },
        "biasTypes": { "type": "array", "description": "Identified list of bias markers (e.g. ['Gender', 'Location', 'Age'])." },
        "projectName": { "type": "string", "description": "Name of the audited system/workspace." },
        "timestamp": { "type": "number", "description": "Unix timestamp in ms." }
      },
      "required": ["industry", "biasScore", "biasTypes", "projectName", "timestamp"]
    },
    "ApiKey": {
      "title": "ApiKey",
      "description": "REST API Keys generated by developers for audits authorization.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Owner developer email." },
        "key": { "type": "string", "description": "64-bit secret hex formatted token key." },
        "created_at": { "type": "number", "description": "Timestamp in milliseconds when generated." },
        "request_count": { "type": "number", "description": "Total usage offset against the daily free limit quota." }
      },
      "required": ["email", "key", "created_at", "request_count"]
    },
    "Webhook": {
      "title": "Webhook",
      "description": "Server settings configuration to delivery bias and compliance status reporting to real-time custom endpoints.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Email address of the registering developer." },
        "webhookUrl": { "type": "string", "description": "External target destination payload url." },
        "triggers": { "type": "array", "description": "The selected actions firing notifications." }
      },
      "required": ["email", "webhookUrl", "triggers"]
    }
  },
  "firestore": {
    "timeline/{entryId}": {
      "schema": "TimelineEntry",
      "description": "Chronological audit trends list."
    },
    "shared_reports/{reportId}": {
      "schema": "SharedReport",
      "description": "Independently accessed certificates index."
    },
    "public_audits/{auditId}": {
      "schema": "PublicAudit",
      "description": "Collection of anonymized industry audits."
    },
    "api_keys/{keyId}": {
      "schema": "ApiKey",
      "description": "Indexed list of provisioned credentials."
    },
    "webhooks/{webhookId}": {
      "schema": "Webhook",
      "description": "Webhooks routing configuration."
    }
  }
}
